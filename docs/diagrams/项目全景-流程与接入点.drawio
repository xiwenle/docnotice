  <diagram id="p3" name="03 资料全生命周期">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3-t1" value="&lt;b&gt;资料全生命周期&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5d7083'&gt;创建 → 上传 → 时效计算 → 替换/归档 → 回收站 → 恢复/彻底删除&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontColor=#1b2a38;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1200" height="52" as="geometry"/></mxCell>
<mxCell id="p3-band2" value="① 创建资料（POST /documents）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1720" height="150" as="geometry"/></mxCell>
<mxCell id="p3-c3" value="管理员填表&lt;br&gt;标题 · 编号 · 摘要&lt;br&gt;分类 · 标签 · 生效区间" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="70" y="118" width="300" height="92" as="geometry"/></mxCell>
<mxCell id="p3-c4" value="R1 校验&lt;br&gt;effective_from &amp;gt; effective_to&lt;br&gt;→ 409 VALIDITY_CONFLICT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="400" y="118" width="310" height="92" as="geometry"/></mxCell>
<mxCell id="p3-c5" value="R2 校验&lt;br&gt;与已有区间重叠 → 409&lt;br&gt;需 confirm_overwrite + 原因" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="740" y="118" width="320" height="92" as="geometry"/></mxCell>
<mxCell id="p3-c6" value="写入 documents&lt;br&gt;current_file_id = NULL&lt;br&gt;稍后可上传文件" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="1090" y="118" width="290" height="92" as="geometry"/></mxCell>
<mxCell id="p3-c7" value="审计&lt;br&gt;create_document" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="1410" y="118" width="310" height="92" as="geometry"/></mxCell>
<mxCell id="p3-band8" value="② 上传/替换文件（file_service）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1720" height="240" as="geometry"/></mxCell>
<mxCell id="p3-c9" value="上传&lt;br&gt;PDF/DOCX/XLSX/XLS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="70" y="292" width="230" height="80" as="geometry"/></mxCell>
<mxCell id="p3-c10" value="&lt;b&gt;文件安全 6 步&lt;/b&gt;&lt;br&gt;① 扩展名白名单&lt;br&gt;② 魔数/真实解析&lt;br&gt;③ 服务端 MIME 派生&lt;br&gt;④ 大小上限(边读边计)&lt;br&gt;⑤ 文件名清洗&lt;br&gt;⑥ safe_join 防穿越" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="330" y="286" width="300" height="172" as="geometry"/></mxCell>
<mxCell id="p3-c11" value="save_upload&lt;br&gt;uuid4 随机内部名&lt;br&gt;分片 documents/xx/" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="660" y="292" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="p3-c12" value="替换旧文件？&lt;br&gt;→ recycle_file&lt;br&gt;reason='replaced'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="970" y="292" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="p3-c13" value="新 file_record&lt;br&gt;current_file_id 更新&lt;br&gt;rev_count++" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="1260" y="292" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="p3-c14" value="失败补偿&lt;br&gt;两阶段原子&lt;br&gt;DB 回滚 + 物理补偿" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="970" y="392" width="260" height="66" as="geometry"/></mxCell>
<mxCell id="p3-c15" value="审计 replace_file" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="1260" y="392" width="270" height="66" as="geometry"/></mxCell>
<mxCell id="p3-band16" value="③ 时效状态（自动计算，不落库）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="1720" height="200" as="geometry"/></mxCell>
<mxCell id="p3-c17" value="as_of &amp;lt; effective_from&lt;br&gt;→ &lt;b&gt;待生效&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="70" y="552" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="p3-c18" value="from ≤ as_of ≤ to&lt;br&gt;或 to 为空&lt;br&gt;→ &lt;b&gt;有效&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="350" y="552" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="p3-c19" value="as_of &amp;gt; effective_to&lt;br&gt;→ &lt;b&gt;已失效&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="680" y="552" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="p3-c20" value="archived_at 非空&lt;br&gt;→ &lt;b&gt;已归档&lt;/b&gt;&lt;br&gt;(优先级最高)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="960" y="552" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="p3-c21" value="&lt;b&gt;闭区间&lt;/b&gt;：to 当天仍有效&lt;br&gt;&lt;b&gt;空值&lt;/b&gt;：目前没有已知失效日期(≠永不失效)&lt;br&gt;&lt;b&gt;历史查询&lt;/b&gt;：?as_of_date= 重新计算" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="1240" y="552" width="480" height="70" as="geometry"/></mxCell>
<mxCell id="p3-c22" value="管理员不能手工填状态&lt;br&gt;无 status 列，只能改日期区间" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="350" y="636" width="300" height="56" as="geometry"/></mxCell>
<mxCell id="p3-c23" value="列表 SQL 与 compute_status&lt;br&gt;逐条等价（防口径漂移）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="680" y="636" width="340" height="56" as="geometry"/></mxCell>
<mxCell id="p3-band24" value="④ 归档 / 恢复 / 彻底删除" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1720" height="250" as="geometry"/></mxCell>
<mxCell id="p3-c25" value="DELETE /documents/{id}&lt;br&gt;archive_document&lt;br&gt;archived_at + reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="70" y="772" width="290" height="80" as="geometry"/></mxCell>
<mxCell id="p3-c26" value="当前文件 → 回收站&lt;br&gt;reason='archived'&lt;br&gt;无文件也留档" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="390" y="772" width="290" height="80" as="geometry"/></mxCell>
<mxCell id="p3-c27" value="POST /{id}/restore&lt;br&gt;清 archived_at&lt;br&gt;文件回 documents/" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="710" y="772" width="290" height="80" as="geometry"/></mxCell>
<mxCell id="p3-c28" value="回收站&lt;br&gt;restore / purge(confirm)&lt;br&gt;purge-all(confirm)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="1030" y="772" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="p3-c29" value="物理删除&lt;br&gt;仅 recycle purge 入口&lt;br&gt;唯一允许删文件处" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="1360" y="772" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="p3-c30" value="普通用户不可见归档资料&lt;br&gt;列表/详情/下载/预览均 403" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="70" y="880" width="290" height="60" as="geometry"/></mxCell>
<mxCell id="p3-c31" value="旧文件绝不覆盖&lt;br&gt;禁止直接物理删除（§26）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="390" y="880" width="290" height="60" as="geometry"/></mxCell>
<mxCell id="p3-c32" value="归档资料禁止编辑&lt;br&gt;（通知联动除外，见第 4 页）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="710" y="880" width="290" height="60" as="geometry"/></mxCell>
<mxCell id="p3-note33" value="&lt;b&gt;数据安全红线（§8/§26）&lt;/b&gt;&lt;br&gt;· 一个资料只有一份当前文件；替换时旧文件进回收站&lt;br&gt;· 禁止直接覆盖旧文件；禁止直接物理删除业务文件&lt;br&gt;· 归档是软删除，回收站可恢复&lt;br&gt;· 永久删除必须 confirm=true（单条/批量一致）&lt;br&gt;· allow_download 只关下载入口，不关预览（使用约定，非安全边界）" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f0f6ec;strokeColor=#6b9a68;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="1010" width="800" height="180" as="geometry"/></mxCell>
<mxCell id="p3-note34" value="&lt;b&gt;分类约束（§9）&lt;/b&gt;&lt;br&gt;层级上限 4 级（MAX_DEPTH）&lt;br&gt;移动分类时校验&lt;b&gt;整棵子树&lt;/b&gt;移动后深度&lt;br&gt;（2026-10-29 修复：此前可构造 7 级）&lt;br&gt;同节点成环、挂到子孙下 → 400" style="shape=note;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#8aa4bb;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900" y="1010" width="820" height="180" as="geometry"/></mxCell>
<mxCell id="p3-e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d7083;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#41556a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-c3" target="p3-c4"><mxGeometry relative="1" as="geometry"/></mxCell>
