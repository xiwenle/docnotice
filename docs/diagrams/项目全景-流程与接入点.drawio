<mxCell id="p2-c4" value="auth_service.login&lt;br&gt;① 查用户&lt;br&gt;② 限速检查" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="320" y="122" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="p2-c5" value="bcrypt 校验&lt;br&gt;用户不存在时不跑哈希&lt;br&gt;(时间侧信道 · 已知 P2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="610" y="122" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="p2-c6" value="签发 JWT&lt;br&gt;{user_id, role, ver}&lt;br&gt;有效期 720 分钟" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="910" y="122" width="250" height="80" as="geometry"/></mxCell>
<mxCell id="p2-c7" value="设置 Cookie&lt;br&gt;HttpOnly · SameSite=Lax&lt;br&gt;Secure 按 APP_ENV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="1190" y="122" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="p2-c8" value="响应体也返回 access_token&lt;br&gt;(纵深防御面 · 已知 P2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="1480" y="122" width="210" height="80" as="geometry"/></mxCell>
<mxCell id="p2-c9" value="失败 401 / 429&lt;br&gt;审计 login_failed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="610" y="226" width="270" height="60" as="geometry"/></mxCell>
<mxCell id="p2-c10" value="成功：审计 login&lt;br&gt;记录 ip / user_agent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="910" y="226" width="250" height="60" as="geometry"/></mxCell>
<mxCell id="p2-band11" value="每请求鉴权（app/core/deps.py）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1670" height="330" as="geometry"/></mxCell>
<mxCell id="p2-c12" value="Cookie 或&lt;br&gt;Authorization: Bearer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="70" y="382" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="p2-c13" value="① decode_access_token&lt;br&gt;签名 / 过期" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="340" y="382" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="p2-c14" value="② db.get(User)&lt;br&gt;auth_source=='local'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="620" y="382" width="270" height="70" as="geometry"/></mxCell>
<mxCell id="p2-c15" value="③ is_active&lt;br&gt;停用立即失效" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="920" y="382" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="p2-c16" value="④ role 复核&lt;br&gt;令牌 ≠ 库 → 401" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="1190" y="382" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="p2-c17" value="⑤ token_version 复核&lt;br&gt;ver ≠ 库值 → 401&lt;br&gt;(新登录/改密顶掉旧设备)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="620" y="490" width="270" height="76" as="geometry"/></mxCell>
<mxCell id="p2-c18" value="⑥ must_change_password 闸门&lt;br&gt;&lt;b&gt;计划移除，见页底&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="920" y="490" width="240" height="76" as="geometry"/></mxCell>
<mxCell id="p2-c19" value="⑦ 放行&lt;br&gt;current_user 注入依赖" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="1190" y="490" width="250" height="76" as="geometry"/></mxCell>
<mxCell id="p2-c20" value="拒绝：401 / 403&lt;br&gt;页面路由吞异常 → 匿名态" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="240" height="76" as="geometry"/></mxCell>
<mxCell id="p2-c21" value="require_roles(&quot;admin&quot;)&lt;br&gt;普通用户调用管理端点 → 403" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="340" y="490" width="250" height="76" as="geometry"/></mxCell>
<mxCell id="p2-band23" value="角色与边界（权限模型 v3：两角色）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1670" height="180" as="geometry"/></mxCell>
<mxCell id="p2-c24" value="&lt;b&gt;user 普通员工&lt;/b&gt;&lt;br&gt;查看/搜索资料 · 在线预览&lt;br&gt;下载（受 allow_download）&lt;br&gt;查看/阅读自己的通知" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="70" y="742" width="350" height="120" as="geometry"/></mxCell>
<mxCell id="p2-c25" value="&lt;b&gt;admin 管理员&lt;/b&gt;&lt;br&gt;资料/通知/分类/标签/类型&lt;br&gt;用户/部门 · 回收站&lt;br&gt;备份恢复 · 阅读统计 · 操作日志" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#2b5d8c;strokeColor=#1f4568;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="742" width="350" height="120" as="geometry"/></mxCell>
<mxCell id="p2-note26" value="权限必须后端校验（AGENTS §33）&lt;br&gt;前端隐藏按钮只是体验，不承担权限。&lt;br&gt;所有管理端点由&lt;br&gt;Depends(require_roles(&quot;admin&quot;)) 强制。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d9b45a;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="742" width="400" height="120" as="geometry"/></mxCell>
<mxCell id="p2-c27" value="登出 POST /auth/logout&lt;br&gt;清 Cookie + 审计&lt;br&gt;&lt;b&gt;不 bump token_version&lt;/b&gt;&lt;br&gt;已知 P2：令牌 12h 内仍可用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="1260" y="742" width="420" height="120" as="geometry"/></mxCell>
