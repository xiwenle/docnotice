<mxCell id="p5-c5" value="&lt;b&gt;file_records&lt;/b&gt;&lt;br&gt;id · owner_type · owner_id&lt;br&gt;original_filename · internal_name&lt;br&gt;file_type · mime_type · size_bytes&lt;br&gt;sha256 · storage_rel_path · status&lt;br&gt;&lt;font color='#2b5d8c'&gt;uploaded_by → users&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;shape=table;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7f97ad;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="1290" y="110" width="330" height="150" as="geometry"/></mxCell>
