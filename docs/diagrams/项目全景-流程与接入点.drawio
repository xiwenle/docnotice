        <mxCell id="p5-t1" value="&lt;b&gt;数据模型 · 17 张表&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5d7083'&gt;SQLite 单文件；数据库只存元数据与关系，文件二进制在文件系统&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontColor=#1b2a38;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1200" height="52" as="geometry"/></mxCell>
<mxCell id="p5-c2" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;id · username · password_hash&lt;br&gt;display_name · role · is_active&lt;br&gt;must_change_password&lt;br&gt;auth_source · external_uid&lt;br&gt;token_version · last_login_at" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;shape=table;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7f97ad;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="90" y="110" width="330" height="150" as="geometry"/></mxCell>
<mxCell id="p5-c3" value="&lt;b&gt;documents&lt;/b&gt;&lt;br&gt;id · title · summary&lt;br&gt;&lt;font color='#2b5d8c'&gt;category_id → categories&lt;/font&gt;&lt;br&gt;effective_from · effective_to&lt;br&gt;&lt;font color='#2b5d8c'&gt;current_file_id → file_records&lt;/font&gt;&lt;br&gt;rev_count · archived_at · created_by&lt;br&gt;allow_download · audience_scope" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;shape=table;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7f97ad;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="330" height="150" as="geometry"/></mxCell>
