<mxCell id="p5-c10" value="&lt;b&gt;user_departments&lt;/b&gt;&lt;br&gt;&lt;font color='#2b5d8c'&gt;user_id → users&lt;/font&gt;&lt;br&gt;&lt;font color='#2b5d8c'&gt;department_id → departments&lt;/font&gt;&lt;br&gt;（用户 ↔ 部门 M:N）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;shape=table;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7f97ad;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="90" y="490" width="330" height="150" as="geometry"/></mxCell>
