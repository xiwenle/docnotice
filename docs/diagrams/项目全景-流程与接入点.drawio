  <diagram id="p4" name="04 通知生命周期与联动">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p4-t1" value="&lt;b&gt;通知全生命周期与资料联动&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5d7083'&gt;草稿 → 发布 → 阅读；废止/替换类型触发资料时效截断&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontColor=#1b2a38;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1200" height="52" as="geometry"/></mxCell>
<mxCell id="p4-band2" value="① 状态机" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1740" height="180" as="geometry"/></mxCell>
<mxCell id="p4-c3" value="&lt;b&gt;draft 草稿&lt;/b&gt;&lt;br&gt;自由修改&lt;br&gt;可删除" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="90" y="126" width="230" height="100" as="geometry"/></mxCell>
<mxCell id="p4-c4" value="&lt;b&gt;published&lt;/b&gt;&lt;br&gt;物化阅读快照&lt;br&gt;联动生效" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="480" y="126" width="230" height="100" as="geometry"/></mxCell>
<mxCell id="p4-c5" value="&lt;b&gt;cancelled 已取消&lt;/b&gt;&lt;br&gt;联动回滚&lt;br&gt;可恢复/彻底删" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="870" y="126" width="230" height="100" as="geometry"/></mxCell>
<mxCell id="p4-c6" value="通知修改限制&lt;br&gt;有人已读后须&lt;br&gt;confirm_modify=true&lt;br&gt;+ modified_reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="1260" y="126" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="p4-c7" value="禁止改阅读对象&lt;br&gt;(防绕过既有快照)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="1580" y="126" width="190" height="100" as="geometry"/></mxCell>
<mxCell id="p4-band8" value="② 发布（POST /notices/{id}/publish）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="1740" height="220" as="geometry"/></mxCell>
<mxCell id="p4-c9" value="校验&lt;br&gt;confirm_targets=true&lt;br&gt;阅读对象非空" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="70" y="332" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="p4-c10" value="status → published&lt;br&gt;published_at = now" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="360" y="332" width="250" height="76" as="geometry"/></mxCell>
<mxCell id="p4-c11" value="物化阅读快照&lt;br&gt;notice_reads&lt;br&gt;(每个应读人一行)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="640" y="332" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="p4-c12" value="reconcile_auto_expire_linkage&lt;br&gt;废止/替换 → effective_to&lt;br&gt;= 生效日(含已归档)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="930" y="332" width="350" height="76" as="geometry"/></mxCell>
<mxCell id="p4-c13" value="冲突 → 整体回滚&lt;br&gt;R1 违规则发布失败&lt;br&gt;(不允许半发布)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="1310" y="332" width="300" height="76" as="geometry"/></mxCell>
<mxCell id="p4-c14" value="同一幂等实现被 4 处共用：publish / update / cancel / restore&lt;br&gt;防止「写入方有三个字段、重算只有一个入口」的口径漂移" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="640" y="428" width="670" height="62" as="geometry"/></mxCell>
<mxCell id="p4-c15" value="审计 publish_notice" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="1340" y="428" width="270" height="62" as="geometry"/></mxCell>
<mxCell id="p4-band16" value="③ 阅读（§20/§21）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="1740" height="200" as="geometry"/></mxCell>
<mxCell id="p4-c17" value="打开通知详情&lt;br&gt;→ 写 read_at" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="70" y="572" width="250" height="76" as="geometry"/></mxCell>
<mxCell id="p4-c18" value="&lt;b&gt;确认功能已下线&lt;/b&gt;（2026-11-03）&lt;br&gt;只保留「已查看」单一维度&lt;br&gt;confirmed_at 列已删除" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="360" y="572" width="340" height="76" as="geometry"/></mxCell>
<mxCell id="p4-c19" value="两态&lt;br&gt;未查看 / 已查看" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="740" y="572" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="p4-c20" value="阅读统计&lt;br&gt;分母 = 快照 ∩ 启用用户&lt;br&gt;&lt;b&gt;不含管理员&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="1040" y="572" width="320" height="76" as="geometry"/></mxCell>
<mxCell id="p4-c21" value="阅读对象三种范围&lt;br&gt;全体 / 指定部门 / 指定用户" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="1400" y="572" width="340" height="76" as="geometry"/></mxCell>
<mxCell id="p4-c22" value="截止时间仅作展示&lt;br&gt;不影响查看" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="740" y="660" width="260" height="54" as="geometry"/></mxCell>
<mxCell id="p4-c23" value="纯 API 调用不自动置读&lt;br&gt;置读由详情页前端触发" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="1040" y="660" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="p4-band24" value="④ 取消 / 恢复 / 删除" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1740" height="190" as="geometry"/></mxCell>
<mxCell id="p4-c25" value="取消 cancel&lt;br&gt;联动回滚(按账本)&lt;br&gt;恢复管理员独立改的日期" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="70" y="792" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="p4-c26" value="恢复 restore&lt;br&gt;废止/替换重新应用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="440" y="792" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="p4-c27" value="草稿删除&lt;br&gt;直接删" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="760" y="792" width="230" height="90" as="geometry"/></mxCell>
<mxCell id="p4-c28" value="彻底删除(confirm)&lt;br&gt;物理删通知&lt;br&gt;阅读快照随删" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="1030" y="792" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="p4-c29" value="通知类型词表&lt;br&gt;管理员可增删&lt;br&gt;内置：发布/修订/替换/废止/延期/其他" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="1370" y="792" width="370" height="90" as="geometry"/></mxCell>
<mxCell id="p4-note30" value="&lt;b&gt;联动语义边界（已知问题，待修）&lt;/b&gt;&lt;br&gt;· 解除关联时账本条目被无条件 pop，再关联会被当「首次」重新截断&lt;br&gt;  （与「墓碑永久不干预」的注释矛盾）&lt;br&gt;· skip_archived=False 会修改已归档资料有效期&lt;br&gt;· 内置联动类型（废止/替换）改名一律 409" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fdf0dc;strokeColor=#d2983f;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="970" width="820" height="170" as="geometry"/></mxCell>
<mxCell id="p4-note31" value="&lt;b&gt;阅读统计口径&lt;/b&gt;&lt;br&gt;应读 = 发布时快照 ∩ users.is_active ∩ role≠admin&lt;br&gt;已查看 = read_at 非空，未查看 = 应读 − 已查看&lt;br&gt;确认维度已于 2026-11-03 整体下线（只剩两态）" style="shape=note;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#8aa4bb;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="920" y="970" width="820" height="170" as="geometry"/></mxCell>
