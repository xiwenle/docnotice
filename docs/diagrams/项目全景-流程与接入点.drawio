<mxCell id="p5-c14" value="&lt;b&gt;document_targets&lt;/b&gt;&lt;br&gt;&lt;font color='#2b5d8c'&gt;document_id → documents&lt;/font&gt;&lt;br&gt;&lt;font color='#2b5d8c'&gt;department_id → departments&lt;/font&gt;&lt;br&gt;&lt;font color='#2b5d8c'&gt;user_id → users&lt;/font&gt;&lt;br&gt;target_type：全体/部门/用户" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;shape=table;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7f97ad;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="90" y="680" width="330" height="150" as="geometry"/></mxCell>
<mxCell id="p5-c15" value="&lt;b&gt;notice_reads&lt;/b&gt;&lt;br&gt;&lt;font color='#2b5d8c'&gt;notice_id → notices&lt;/font&gt;&lt;br&gt;&lt;font color='#2b5d8c'&gt;user_id → users&lt;/font&gt;&lt;br&gt;read_at · read_ip&lt;br&gt;（两态：未查看/已查看；管理员不入快照）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;shape=table;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7f97ad;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="490" y="680" width="330" height="150" as="geometry"/></mxCell>
<mxCell id="p5-c16" value="&lt;b&gt;recycle_bin&lt;/b&gt;&lt;br&gt;&lt;font color='#2b5d8c'&gt;document_id → documents&lt;/font&gt;&lt;br&gt;&lt;font color='#2b5d8c'&gt;file_record_id → file_records&lt;/font&gt;&lt;br&gt;reason：replaced / archived&lt;br&gt;origin_rel_path&lt;br&gt;deleted_by / restored_by / purged_by" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;shape=table;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7f97ad;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="890" y="680" width="330" height="150" as="geometry"/></mxCell>
<mxCell id="p5-c17" value="&lt;b&gt;backup_records&lt;/b&gt;&lt;br&gt;id · backup_type · backup_path&lt;br&gt;manifest_path · size_bytes&lt;br&gt;db_sha256 · file_count&lt;br&gt;status · source&lt;br&gt;&lt;font color='#2b5d8c'&gt;created_by / restored_by → users&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;shape=table;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7f97ad;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="1290" y="680" width="330" height="150" as="geometry"/></mxCell>
<mxCell id="p5-c18" value="&lt;b&gt;audit_logs&lt;/b&gt;&lt;br&gt;&lt;font color='#2b5d8c'&gt;user_id → users（删用户置 NULL）&lt;/font&gt;&lt;br&gt;username（文本保留）&lt;br&gt;action · object_type · object_id&lt;br&gt;detail(JSON) · ip · user_agent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;shape=table;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7f97ad;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="90" y="870" width="330" height="150" as="geometry"/></mxCell>
<mxCell id="p5-note19" value="&lt;b&gt;关系设计要点&lt;/b&gt;&lt;br&gt;· documents.current_file_id 与 file_records 是「当前文件」指针；历史文件在 recycle_bin&lt;br&gt;· 通知 ↔ 资料 M:N（notice_documents）：一个通知可关联多份资料，反之亦然&lt;br&gt;· 阅读分母 = notice_targets 快照 ∩ users.is_active（不含管理员）&lt;br&gt;· 资料可见范围 = documents.audience_scope + document_targets&lt;br&gt;· categories 自关联树，服务层强制 ≤4 级且防成环&lt;br&gt;· audit_logs 删用户时 user_id 置 NULL、username 文本保留（§25 留痕）" style="shape=note;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#8aa4bb;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="90" y="1140" width="790" height="190" as="geometry"/></mxCell>
<mxCell id="p5-note20" value="&lt;b&gt;17 张表构成&lt;/b&gt;&lt;br&gt;实体表 11：users · departments · documents&lt;br&gt;file_records · categories · tags · notices&lt;br&gt;notice_types · recycle_bin · backup_records · audit_logs&lt;br&gt;&lt;br&gt;关联/范围表 6：user_departments · document_tags&lt;br&gt;notice_documents · notice_targets&lt;br&gt;document_targets · notice_reads&lt;br&gt;合计 17（与 docs/DATABASE.md 一致）" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d9b45a;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="920" y="1140" width="750" height="190" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p6" name="06 备份与恢复">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1220" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p6-t1" value="&lt;b&gt;备份与恢复&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#5d7083'&gt;备份覆盖 数据库 + 业务文件；恢复是破坏性操作，全程互斥&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontColor=#1b2a38;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1200" height="52" as="geometry"/></mxCell>
<mxCell id="p6-band2" value="① 创建备份（POST /backups）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1720" height="250" as="geometry"/></mxCell>
<mxCell id="p6-c3" value="请求&lt;br&gt;backup_type=full|database&lt;br&gt;source=manual|auto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="70" y="122" width="260" height="84" as="geometry"/></mxCell>
<mxCell id="p6-c4" value="&lt;b&gt;恢复互斥检查&lt;/b&gt;&lt;br&gt;_restore_lock.locked()?&lt;br&gt;→ 409 CONFLICT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="270" height="84" as="geometry"/></mxCell>
<mxCell id="p6-c5" value="磁盘硬闸门&lt;br&gt;assert_disk_headroom&lt;br&gt;&lt;b&gt;建目录之前&lt;/b&gt;判" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="680" y="122" width="270" height="84" as="geometry"/></mxCell>
<mxCell id="p6-c6" value="建 backup_&amp;lt;ts&amp;gt;/&lt;br&gt;建 record(processing)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="990" y="122" width="270" height="84" as="geometry"/></mxCell>
<mxCell id="p6-c7" value="SQLite online backup&lt;br&gt;复制 documents/notices/&lt;br&gt;recycle_bin/uploads" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="1300" y="122" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="p6-c8" value="manifest.json&lt;br&gt;schema_version · created_at&lt;br&gt;db_sha256 · 每文件 sha256" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="990" y="230" width="270" height="70" as="geometry"/></mxCell>
<mxCell id="p6-c9" value="status=completed&lt;br&gt;审计 backup_create" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="1300" y="230" width="330" height="70" as="geometry"/></mxCell>
<mxCell id="p6-c10" value="保留策略 apply_retention&lt;br&gt;KEEP_DAYS / KEEP_COUNT&lt;br&gt;PRE_KEEP_COUNT（白名单目录）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="680" y="230" width="270" height="70" as="geometry"/></mxCell>
<mxCell id="p6-c11" value="失败 → status=failed&lt;br&gt;同样写审计（留痕）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="370" y="230" width="270" height="70" as="geometry"/></mxCell>
<mxCell id="p6-band12" value="② 恢复（POST /backups/{id}/restore）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1720" height="400" as="geometry"/></mxCell>
<mxCell id="p6-c13" value="confirm=true&lt;br&gt;否则 400" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="70" y="402" width="230" height="76" as="geometry"/></mxCell>
<mxCell id="p6-c14" value="&lt;b&gt;获取 _restore_lock&lt;/b&gt;&lt;br&gt;非阻塞：已有恢复→409&lt;br&gt;最外层 try/finally 释放" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="340" y="402" width="300" height="76" as="geometry"/></mxCell>
<mxCell id="p6-c15" value="① 安全备份当前状态&lt;br&gt;create_backup(_inside_restore)&lt;br&gt;内部通道绕自锁" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="680" y="402" width="320" height="76" as="geometry"/></mxCell>
<mxCell id="p6-c16" value="② 全量校验&lt;br&gt;manifest + 所有 sha256&lt;br&gt;&lt;b&gt;失败则不动数据&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="1040" y="402" width="290" height="76" as="geometry"/></mxCell>
<mxCell id="p6-c17" value="③ stage 目录&lt;br&gt;复制+校验&lt;br&gt;恢复副本" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="1370" y="402" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="p6-c18" value="④ 释放池化连接" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="680" y="512" width="320" height="64" as="geometry"/></mxCell>
<mxCell id="p6-c19" value="⑤ 回写 app.db&lt;br&gt;切换业务目录&lt;br&gt;旧状态留 *.pre_&amp;lt;ts&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="1040" y="512" width="290" height="64" as="geometry"/></mxCell>
<mxCell id="p6-c20" value="⑥ 新会话记录&lt;br&gt;restored + 审计&lt;br&gt;补录安全备份" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="1370" y="512" width="260" height="64" as="geometry"/></mxCell>
<mxCell id="p6-c21" value="finally: 释放锁&lt;br&gt;失败路径也必须释放&lt;br&gt;否则系统永久无法恢复" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fbe4e4;strokeColor=#c96a6a;fontColor=#8a2626;" vertex="1" parent="1"><mxGeometry x="340" y="512" width="300" height="64" as="geometry"/></mxCell>
<mxCell id="p6-c22" value="并发恢复：第二个 409&lt;br&gt;恢复期间备份：409&lt;br&gt;（2026-10-29 补齐）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="680" y="616" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="p6-c23" value="启动时孤儿备份认领&lt;br&gt;_reclaim_orphan_backups&lt;br&gt;（认领不删除，幂等）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="1040" y="616" width="290" height="70" as="geometry"/></mxCell>
<mxCell id="p6-band24" value="③ 备份覆盖范围（§28：不能只备数据库）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1720" height="180" as="geometry"/></mxCell>
<mxCell id="p6-c25" value="data/database/app.db&lt;br&gt;(online backup 快照)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dfe9f3;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="70" y="842" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="p6-c26" value="data/documents/&lt;br&gt;资料当前文件" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="400" y="842" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="p6-c27" value="data/notices/&lt;br&gt;通知附件" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="680" y="842" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="p6-c28" value="data/recycle_bin/&lt;br&gt;回收站文件" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="960" y="842" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="p6-c29" value="data/uploads/&lt;br&gt;(预留，一并备份)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="1240" y="842" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="p6-c30" value="不备份 backups/ 自身&lt;br&gt;(避免递归膨胀)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="1520" y="842" width="200" height="110" as="geometry"/></mxCell>
<mxCell id="p6-note31" value="&lt;b&gt;灾备边界（§28 锁定决策）&lt;/b&gt;&lt;br&gt;不做异地/双机/离机灾备拷贝。应用内自动备份 + 同机保留策略即最终方案。&lt;br&gt;配套纪律：磁盘健康纳入日常巡检（启动巡检 + 备份前硬闸门）。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d9b45a;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="1020" width="820" height="160" as="geometry"/></mxCell>
<mxCell id="p6-note32" value="&lt;b&gt;已知限制&lt;/b&gt;&lt;br&gt;· 显式设 DATABASE_URL 时，备份仍取 DATA_DIR/database/app.db，&lt;br&gt;  可能与 engine 实际连接的库不是同一个（建议保持留空）&lt;br&gt;· 进程内锁：多 worker / 多实例部署会失效（必须单实例）" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fdf0dc;strokeColor=#d2983f;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="920" y="1020" width="800" height="160" as="geometry"/></mxCell>
<mxCell id="p6-e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d7083;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#41556a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-c3" target="p6-c4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d7083;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#41556a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-c4" target="p6-c5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d7083;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#41556a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-c5" target="p6-c6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d7083;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#41556a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-c6" target="p6-c7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d7083;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#41556a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6-c7" target="p6-c8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d7083;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#41556a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-c8" target="p6-c10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d7083;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#41556a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-c10" target="p6-c11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d7083;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#41556a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-c13" target="p6-c14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d7083;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#41556a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-c14" target="p6-c15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d7083;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#41556a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-c15" target="p6-c16"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d7083;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#41556a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-c16" target="p6-c17"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d7083;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#41556a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6-c16" target="p6-c19"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d7083;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#41556a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-c19" target="p6-c20"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p7" name="07 接入点与部署运维">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="p7-band2" value="接入点清单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1720" height="470" as="geometry"/></mxCell>
<mxCell id="p7-c3" value="&lt;b&gt;① HTTP 唯一入口&lt;/b&gt;&lt;br&gt;浏览器 → uvicorn&lt;br&gt;所有流量经 SecurityMiddleware&lt;br&gt;内网防火墙 + IP 白名单是第一道闸门" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#2b5d8c;strokeColor=#1f4568;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="122" width="320" height="190" as="geometry"/></mxCell>
<mxCell id="p7-c5" value="&lt;b&gt;③ 文件系统 DATA_DIR&lt;/b&gt;&lt;br&gt;documents / notices / recycle_bin&lt;br&gt;backups / uploads / logs / database&lt;br&gt;必须本地磁盘（SQLite 不支持网络盘）&lt;br&gt;路径全部由配置派生，无硬编码" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="750" y="122" width="320" height="190" as="geometry"/></mxCell>
<mxCell id="p7-c6" value="&lt;b&gt;④ SQLite 单文件库&lt;/b&gt;&lt;br&gt;data/database/app.db&lt;br&gt;17 张表；不存文件二进制&lt;br&gt;备份用 online backup API&lt;br&gt;单进程写入" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dfe9f3;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="1090" y="122" width="320" height="190" as="geometry"/></mxCell>
<mxCell id="p7-c7" value="&lt;b&gt;⑤ 内网 pip 源&lt;/b&gt;&lt;br&gt;requirements.txt 全量 pin&lt;br&gt;部署时 pip install&lt;br&gt;公司镜像源或官方源&lt;br&gt;注意 shell 里的 HTTP_PROXY" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="1430" y="122" width="320" height="190" as="geometry"/></mxCell>
<mxCell id="p7-c8" value="&lt;b&gt;⑥ 进程常驻&lt;/b&gt;&lt;br&gt;Linux: systemd unit&lt;br&gt;Windows: 任务计划程序&lt;br&gt;&lt;b&gt;必须单实例&lt;/b&gt;&lt;br&gt;多实例会破坏缓存/调度/锁" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#2b5d8c;strokeColor=#1f4568;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="340" width="320" height="190" as="geometry"/></mxCell>
<mxCell id="p7-c9" value="&lt;b&gt;⑦ 自动备份调度&lt;/b&gt;&lt;br&gt;app/core/scheduler.py&lt;br&gt;BACKUP_SCHEDULE (sat/daily HH:MM)&lt;br&gt;进程内线程，启动补跑&lt;br&gt;留空 = 关闭" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#e8f1e6;strokeColor=#6b9a68;fontColor=#2c4a2a;" vertex="1" parent="1"><mxGeometry x="410" y="340" width="320" height="190" as="geometry"/></mxCell>
<mxCell id="p7-c10" value="&lt;b&gt;⑧ 磁盘与日志&lt;/b&gt;&lt;br&gt;log_startup_disk_health()&lt;br&gt;assert_disk_headroom()&lt;br&gt;logs/app.log&lt;br&gt;DISK_MIN_FREE_MB / PERCENT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#fdf0dc;strokeColor=#d2983f;fontColor=#7a4d10;" vertex="1" parent="1"><mxGeometry x="750" y="340" width="320" height="190" as="geometry"/></mxCell>
<mxCell id="p7-c11" value="&lt;b&gt;⑨ 时间与时区&lt;/b&gt;&lt;br&gt;服务器本地时间决定&lt;br&gt;待生效/有效/已失效&lt;br&gt;历史查询 as_of_date&lt;br&gt;部署时确认时区正确" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="1090" y="340" width="320" height="190" as="geometry"/></mxCell>
<mxCell id="p7-c12" value="&lt;b&gt;⑩ 运维审计出口&lt;/b&gt;&lt;br&gt;/admin/audit-logs&lt;br&gt;查阅 / 删除&lt;br&gt;删日志本身写 audit_delete&lt;br&gt;（可追溯但可逐条擦除）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#eef1f4;strokeColor=#9aa9b8;fontColor=#31414f;" vertex="1" parent="1"><mxGeometry x="1430" y="340" width="320" height="190" as="geometry"/></mxCell>
<mxCell id="p7-band13" value="部署流程（AGENTS §37/§38）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#a9bccd;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#33475b;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1720" height="330" as="geometry"/></mxCell>
<mxCell id="p7-c14" value="&lt;b&gt;1. 准备服务器&lt;/b&gt;&lt;br&gt;Python 3.10+&lt;br&gt;本地磁盘 ≥ 业务量×3&lt;br&gt;内网 IP / 域名" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="70" y="612" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="p7-c15" value="&lt;b&gt;2. 代码与 venv&lt;/b&gt;&lt;br&gt;拉代码&lt;br&gt;&lt;b&gt;不拷 data/ 与 .venv&lt;/b&gt;&lt;br&gt;python -m venv .venv" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="410" y="612" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="p7-c16" value="&lt;b&gt;3. 依赖&lt;/b&gt;&lt;br&gt;pip install -r requirements.txt&lt;br&gt;内网镜像源&lt;br&gt;核对 pin 无漂移" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="750" y="612" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="p7-c17" value="&lt;b&gt;4. 配置 .env&lt;/b&gt;&lt;br&gt;APP_ENV=production&lt;br&gt;SECRET_KEY 强随机&lt;br&gt;DATA_DIR 绝对路径&lt;br&gt;COOKIE_SECURE=false(http)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="1090" y="612" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="p7-c18" value="&lt;b&gt;5. 预检&lt;/b&gt;&lt;br&gt;scripts/check_env.py&lt;br&gt;&lt;b&gt;退出码必须 0&lt;/b&gt;&lt;br&gt;只读，不建目录" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="1430" y="612" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="p7-c19" value="&lt;b&gt;6. 建库&lt;/b&gt;&lt;br&gt;scripts/init_db.py&lt;br&gt;空库建 16 表 + 初始管理员&lt;br&gt;&lt;b&gt;升级时必须跑 migrate.py&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="70" y="782" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="p7-c20" value="&lt;b&gt;7. 常驻&lt;/b&gt;&lt;br&gt;systemd / 任务计划&lt;br&gt;--host --port&lt;br&gt;单进程" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="410" y="782" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="p7-c21" value="&lt;b&gt;8. 网络边界&lt;/b&gt;&lt;br&gt;防火墙只放行业务端口&lt;br&gt;IP 白名单&lt;br&gt;反代则 HOST=127.0.0.1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="750" y="782" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="p7-c22" value="&lt;b&gt;9. 验收&lt;/b&gt;&lt;br&gt;健康检查 /health&lt;br&gt;完整业务走查&lt;br&gt;备份 → 恢复演练" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="1090" y="782" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="p7-c23" value="&lt;b&gt;10. 上线后&lt;/b&gt;&lt;br&gt;首登改密（当前）&lt;br&gt;移除 INITIAL_ADMIN_PASSWORD&lt;br&gt;开启自动备份" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#8aa4bb;fontColor=#1f2d3a;fillColor=#dce8f2;strokeColor=#6f93b5;fontColor=#1f3a55;" vertex="1" parent="1"><mxGeometry x="1430" y="782" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="p7-note25" value="&lt;b&gt;安全边界（不可让步）&lt;/b&gt;&lt;br&gt;· 权限必须后端校验，前端隐藏按钮不算权限&lt;br&gt;· data/ 绝不静态暴露；文件访问必须过后端鉴权&lt;br&gt;· 上传：扩展名 + 魔数 + MIME + 大小 + 文件名清洗 + 防穿越&lt;br&gt;· 生产关闭 /docs /redoc /openapi.json&lt;br&gt;· APP_ENV 非法直接拒绝启动（不静默降级）&lt;br&gt;· 密钥/密码不写代码、不入 Git" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f0f6ec;strokeColor=#6b9a68;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="940" y="930" width="820" height="240" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>