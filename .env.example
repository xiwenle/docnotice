# =============================================================
# 公司内部资料与通知管理系统 —— 配置样例
# 使用方法：复制本文件为 .env 后按需修改
#   cp .env.example .env
# 真实密钥严禁提交到 Git（项目规范 §29）
# 环境变量优先级高于 .env
#
# ⚠️ 本文件**只能写行首注释，不能写行尾注释**。
#    原因：Linux systemd 的 EnvironmentFile 解析器只把行首的 # 当注释，
#    行尾的 # ... 会被原样拼进值（例如 APP_ENV=development  # x 会让
#    APP_ENV 变成 "development  # x" → 判为非法值 → 拒绝启动）。
#    应用自己读 .env 时会剥行尾注释，所以「手动 uvicorn 能跑、systemd 崩」
#    是最容易误导人的坑。运维脚本 scripts/check_env.py 会检查此约束。
# =============================================================

# ---- 应用基本信息 ----
APP_NAME=作业资料系统
# development | production
APP_ENV=development
# 部署约定值：uvicorn 不读取 .env，监听地址/端口需在启动命令
# 或 systemd 中以 --host/--port 显式传入
HOST=127.0.0.1
PORT=8000

# ---- 身份认证 ----
# 本系统使用自建账号体系（local）。
AUTH_PROVIDER=local

# ---- 数据目录与数据库（禁止硬编码绝对路径，相对路径基于项目根目录解析）----
# 业务数据根目录（与程序代码分离，项目规范 §7）
DATA_DIR=./data
# DATABASE_URL 可选：显式指定完整 SQLite URL 覆盖默认数据库位置
# （app/core/config.py 的 database_url 属性：设置了就用它，否则自动派生自 DATA_DIR）
# 注意：显式设置时请使用【绝对路径】，例如：
#   DATABASE_URL=sqlite:////absolute/path/to/app.db
# 相对路径 sqlite:///./data/database/app.db 会按【进程工作目录】解析，
# 与 DATA_DIR 的"基于项目根目录解析"语义不同，容易踩坑；默认留空即可。
# ⚠️ 显式设置 DATABASE_URL 时，应用内备份/恢复仍以 DATA_DIR/database/app.db
#    为准（见 docs/DEPLOY.md §6 已知限制）。除非确有必要，建议保持留空。

# ---- 数据库连接池 ----
# 文件型 SQLite 同时允许的连接上限 = DB_POOL_SIZE + DB_MAX_OVERFLOW。
# 默认 20 + 20，与单进程 Uvicorn 的并发工作线程规模匹配；
# 100 用户突发访问时超出部分会在池内排队，而不是直接创建无限连接。
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
# 等待空闲连接的最长秒数；超时返回 503 DB_BUSY（可重试）
DB_POOL_TIMEOUT_SECONDS=10
# 连接回收秒数，避免长期运行后保留过期文件句柄
DB_POOL_RECYCLE_SECONDS=1800
# ---- 安全 ----
# 生产环境必须替换为足够长的随机字符串，例如：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 长度建议 >=32 字节：PyJWT >=2.15 对 HS256 短密钥（<32 字节）会发 InsecureKeyLengthWarning
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# 令牌有效期（分钟），默认 12 小时
JWT_EXPIRE_MINUTES=720
# bcrypt cost 因子（4-31）。默认 12 安全默认；低配服务器登录慢可降 10~11（只影响新哈希）
BCRYPT_ROUNDS=12
# 登录 Cookie 的 Secure 标志。留空 = 按 APP_ENV 自动（production 开启，其余关闭）。
# 内网 http:// 部署请显式设 false —— 强制 Secure 会让浏览器静默拒存 Cookie，
# 表现为「登录成功却立刻退回登录页」，极难排查；接入 https 后再设 true。
# COOKIE_SECURE=false

# ---- 文件上传与预览 ----
# 单文件大小上限
MAX_UPLOAD_SIZE_MB=50
# DOCX 预览最大段落数（超出截断）
PREVIEW_DOCX_MAX_PARAS=5000
# Excel 预览每表最大行数（超出截断）
PREVIEW_XLSX_MAX_ROWS=2000
# Excel 预览最大工作表数（超出截断）
PREVIEW_XLSX_MAX_SHEETS=20

# ---- 安全（登录限速 / 反代信任）----
# 登录限速：窗口秒数
LOGIN_RATE_WINDOW=60
# 窗口内最大登录尝试次数
LOGIN_RATE_MAX_ATTEMPTS=10
# 部署了可信反向代理时才设为 true（信任 X-Forwarded-For，用于审计 IP）
TRUSTED_HOSTS=localhost,*.localhost,127.0.0.1,::1,testserver
# CSRF Host / Origin 可信白名单（逗号分隔）。默认仅允许本机与 *.localhost；
# 生产域名或 IP 必须显式加入，否则带 Origin 的 POST/PUT/DELETE 会被 403 拒绝。
TRUST_REVERSE_PROXY_HEADERS=false

# ---- 初始管理员（仅 scripts/init_db.py 首次引导时使用）----
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=please-change-me

# ---- 备份策略（README §8、DEPLOY.md §6;清理只碰 data/backups/ 白名单目录）----
# 自动备份调度："sat 03:00"（每周六凌晨3点）/ "daily 03:00"（每天）；留空=关闭
BACKUP_SCHEDULE=sat 03:00
# 备份保留天数：超期备份集在下次备份/恢复后自动清理；0=不按时间清理
BACKUP_KEEP_DAYS=90
# 备份保留份数上限（磁盘兜底）；0=不限份数
BACKUP_KEEP_COUNT=0
# 恢复演练留旧目录（*.pre_<时间戳>）按组保留的组数
BACKUP_PRE_KEEP_COUNT=3

# ---- 磁盘健康阈值（项目规范 §28 配套：本地备份方案下的磁盘巡检）----
# 背景：§28 锁定「不做异地灾备，服务器磁盘健康纳入日常巡检」，
# 本组阈值是那条纪律的自动化落地（app/core/disk_health.py）。
# - 启动时巡检：可用空间不足 → 打 ERROR 日志（不阻止启动，磁盘紧张时仍需可访问）
# - 备份前闸门：可用空间不足 → 拒绝创建备份（避免写出半个备份目录把盘彻底写满）
# 绝对下限：可用空间至少 DISK_MIN_FREE_MB MB
DISK_MIN_FREE_MB=512
# 相对下限：可用空间至少占总空间的 DISK_MIN_FREE_PERCENT %（两个下限都要满足）
DISK_MIN_FREE_PERCENT=5.0
