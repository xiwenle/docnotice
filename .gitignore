# ---- 依赖与虚拟环境 ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- pytest-cov / coverage 本地生成物 ----
.coverage
coverage.xml
htmlcov/

# ---- 业务数据（数据与程序分离，绝不提交 Git，项目规范 §7）----
data/

# ---- 本地环境配置（真实密钥不入库，§29）----
.env

# ---- IDE / 系统 ----
.idea/
.vscode/
.DS_Store

# ---- 日志与临时文件 ----
*.log
*.pid

# ---- pip / pytest 临时目录（TEMP 不可写时会落在仓库根，2026-10-26 加）----
pip-build-tracker-*/
pip-unpack-*/
pip-install-*/
pip-metadata-*/
pip-ephem-wheel-cache-*/
pytest-of-*/
e2e-pdf-*/
edgecases-pdf-*/
tmpx*/

# ---- Agent 工作目录 ----
.agent-teams/
_perf_compare_*/
_perf_compare_*

# ---- 本地验证截图（docs/VERIFICATION.md 引用的本地证据，不入库）----
screenshots/

# ---- DEMO 种子清单（运行时生成，指向本地库的 id，不入库）----
scripts/seed_demo_manifest.json
.a11y_session.json

# ---- 本地审计/验证工具运行目录（2026-08-31 评审遗留，不入库）----
.lh-harness/
