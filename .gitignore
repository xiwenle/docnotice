gui-test-screenshots/

# ---- 设计参照稿（本地留存，不入库）----
# prototypes/ 是设计语言来源，含静态参照稿与样张，属本地交接材料。
# 设计令牌本身已单独提取到 docs/design-tokens/ 入库。
prototypes/

# ---- 环境配置变体（只忽略真实配置，保留 .env.example 模板，§29）----
.env.*
!.env.example

# ---- 数据库文件（正常应位于 data/ 下，此处兜底防误提交）----
*.db
*.sqlite

# ---- 配色参考稿的本地渲染截图（验证证据，不入库；用 _shots.py 可一键重生成）----
prototypes/**/shots/

# ---- 一次性本地清理脚本（本人手动执行，不入库）----
清理垃圾-*.command
清理清单-*.md

# ---- 演示数据归档（本地留存，不入库，2026-10-29）----
data-archive/

# ---- 本地生成的部署包 ----
release/

# ---- 本地审计/走查证据与迁移交接说明（不进入仓库）----
_agent_*/
MIGRATION_README_*.txt
_agent_full_matrix_*/
_agent_ego_*/

